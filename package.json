{
  "name": "yanxing",
  "version": "0.1.0",
  "private": true,
  "description": "研行 · AI 驱动的产业政策研究工作台",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/app-manager.mjs start --mode development",
    "dev:worker": "NODE_ENV=development tsx worker/index.ts",
    "build": "next build --webpack",
    "start": "node scripts/app-manager.mjs start --mode production",
    "stop": "node scripts/app-manager.mjs stop",
    "restart": "node scripts/app-manager.mjs restart",
    "status": "node scripts/app-manager.mjs status",
    "db:migrate": "tsx scripts/migrate.ts",
    "storage:reconcile": "tsx scripts/storage-maintenance.ts",
    "start:worker": "NODE_ENV=production tsx worker/index.ts",
    "user:create": "tsx scripts/create-user.ts",
    "typecheck": "tsc --noEmit -p tsconfig.source.json",
    "test": "node scripts/run-tests.mjs",
    "lint": "tsc --noEmit -p tsconfig.source.json --noUnusedLocals --noUnusedParameters",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@visx/heatmap": "^4.0.0",
    "@visx/hierarchy": "^4.0.0",
    "@visx/wordcloud": "^4.0.0",
    "docx-preview": "^0.4.0",
    "@next/env": "16.3.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "16.3.2",
    "pdf-parse": "^2.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "1.3.3",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.9",
    "typescript": "^5.7.0"
  }
}
