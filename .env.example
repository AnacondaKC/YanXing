# YanXing 运行时环境变量示例
# TypeScript 服务端源码统一由 lib/config/environment.ts 解析；启动边界变量也在此集中列出。
# 以下均为可选配置。
# NODE_ENV 由启动命令设置，无需写入本文件。

# Chat Completions 渠道。API 密钥只通过环境变量传入，不要写入仓库。
# YANXING_CHAT_COMPLETIONS_BASE_URL=https://api.openai.com/v1
# YANXING_CHAT_COMPLETIONS_MODEL=gpt-4.1-mini
# YANXING_CHAT_COMPLETIONS_API_KEY=

# 受信反向代理和应用入口。
# YANXING_TRUST_PROXY=false
# YANXING_TRUSTED_PROXY_HOPS=1
# YANXING_PORT=3000
# Next.js 生产/开发输出目录由应用管理器分别设置，通常无需手动修改。
# YANXING_NEXT_DIST_DIR=.next

# Docker Compose 宿主机配置（不影响 pnpm 本地进程管理器）。
# 容器内数据库、知识库和构建目录由 compose.yaml 固定；详见 docs/docker-deployment.md。
# YANXING_HTTP_PORT=3000
# YANXING_BIND_ADDRESS=127.0.0.1
# YANXING_IMAGE=yanxing:local
# YANXING_NODE_IMAGE=node:24.20.0-bookworm-slim
# YANXING_WEB_MEMORY=2g
# YANXING_WORKER_MEMORY=2g
# YANXING_WEB_CPUS=2
# YANXING_WORKER_CPUS=2

# 本地数据和密钥。
# YANXING_DATABASE_PATH=storage/yanxing.sqlite
# YANXING_KNOWLEDGE_STORAGE_ROOT=storage/knowledge
# 首次创建管理员时通过进程环境传入，不要写入仓库。
# YANXING_ADMIN_PASSWORD=
# 生产环境请设置此项，确保跨部署仍可解密已保存的 API 密钥。
# 未设置时使用数据库所在目录下的 storage/.settings-key。
# YANXING_SETTINGS_ENCRYPTION_KEY=

# 应用管理器日志和临时文件保留策略。
# YANXING_LOG_MAX_BYTES=10485760
# YANXING_LOG_ARCHIVE_RETENTION_DAYS=14
# YANXING_TEMP_RETENTION_DAYS=7
# 日志监控周期；默认 30 分钟。
# YANXING_LOG_WATCH_INTERVAL_MS=1800000

# AI Token 预算和任务队列。
# 以下两项 Token 上限按单用户独立计算；管理员在“设置 → AI 使用预算”保存后以数据库配置为准。
# 7 天窗口包含当天和之前 6 个 UTC 日期，每日 UTC 00:00（北京时间 08:00）向前滚动。
# 页面修改即时用于后续任务的预算检查，不清空已消耗或仍占用的预留额度。
# YANXING_AI_DAILY_TOKENS=5000000
# YANXING_AI_SEVEN_DAY_TOKENS=35000000
# 以下队列容量仅控制并发任务数量，不是 Token 预算。
# YANXING_AI_GLOBAL_QUEUE_LIMIT=64
# YANXING_AI_USER_QUEUE_LIMIT=16
# YANXING_AI_PROJECT_QUEUE_LIMIT=8
# YANXING_AI_INSIGHT_QUEUE_LIMIT=16
# YANXING_AI_RESERVATION_TTL_MS=86400000
# YANXING_AI_RECONCILIATION_INTERVAL_MS=30000
# 分析每次生成预留 10 万 Token；最多 3 次生成，单个分析任务总预留 30 万。
# YANXING_AI_PAGE_ANALYSIS_ESTIMATED_TOKENS=100000
# YANXING_AI_INSIGHT_ESTIMATED_TOKENS=120000

# 模型请求限制。
# YANXING_MODEL_CALLS_PER_MINUTE=30
# 非流式模型首字节等待和流式响应空闲超时；默认 20 分钟。
# YANXING_MODEL_IDLE_TIMEOUT_MS=1200000
# YANXING_MODEL_MAX_CONTEXT_CHARACTERS=120000
# YANXING_MODEL_MAX_OUTPUT_TOKENS=16384
# YANXING_MODEL_MAX_RESPONSE_BYTES=2097152
# 思考强度：auto/low/medium/high/xhigh/max。
# YANXING_MODEL_REASONING_EFFORT=auto

# DOCX/PDF 文件解析和上传限制。
# Docker 中修改上传上限后必须同时重新构建镜像、重建容器，并调整反向代理上限。
# REPORT_MAX_UPLOAD_BYTES=26214400
# REPORT_MAX_UNCOMPRESSED_BYTES=104857600
# REPORT_MAX_ARCHIVE_ENTRY_UNCOMPRESSED_BYTES=26214400
# REPORT_MAX_ARCHIVE_ENTRIES=5000
# REPORT_MAX_COMPRESSION_RATIO=100
# REPORT_MAX_EXTRACTED_CHARACTERS=1000000
# REPORT_MAX_PDF_PAGES=500
# REPORT_MAX_PDF_STREAM_BYTES=268435456
# REPORT_PDF_PARSE_TIMEOUT_MS=30000
# REPORT_PDF_PARSER_MEMORY_MB=256
# REPORT_PDF_PARSER_MAX_RSS_BYTES=536870912
# REPORT_DOCX_PARSE_TIMEOUT_MS=30000
# REPORT_DOCX_PARSER_MEMORY_MB=256
# REPORT_DOCX_PARSE_CONCURRENCY=2
# REPORT_PDF_PARSE_CONCURRENCY=1
# REPORT_PARSE_QUEUE_LIMIT=32
# REPORT_UPLOAD_CONCURRENCY=4
# REPORT_UPLOAD_IDLE_TIMEOUT_MS=30000
# REPORT_UPLOAD_TOTAL_TIMEOUT_MS=600000

# 知识库 multipart 上传限制。
# KNOWLEDGE_UPLOAD_CONCURRENCY=2
# KNOWLEDGE_UPLOAD_IDLE_TIMEOUT_MS=30000
# KNOWLEDGE_UPLOAD_TOTAL_TIMEOUT_MS=600000

# 持久化存储配额和维护。
# YANXING_GLOBAL_STORAGE_BYTES=53687091200
# YANXING_GLOBAL_STORAGE_ITEMS=100000
# YANXING_USER_STORAGE_BYTES=2147483648
# YANXING_USER_STORAGE_ITEMS=5000
# YANXING_PROJECT_STORAGE_BYTES=5368709120
# YANXING_PROJECT_STORAGE_ITEMS=10000
# YANXING_STORAGE_RESERVATION_TTL_MS=900000
# YANXING_STORAGE_MAINTENANCE_INTERVAL_MS=900000

# Worker 进程和任务重试。
# 单个 Worker 的任务并发数，默认 3；可配置为 1-3 的整数。
# YANXING_WORKER_CONCURRENCY=3
# YANXING_WORKER_POLL_MS=1000
# YANXING_WORKER_LEASE_MS=60000
# YANXING_WORKER_MAX_ATTEMPTS=5
# YANXING_WORKER_RETRY_BASE_MS=5000
# YANXING_WORKER_RETRY_MAX_MS=300000

# 任务事件和本地账户会话。
# YANXING_JOB_EVENTS_RETENTION_DAYS=90
# YANXING_SESSION_HOURS=12
# YANXING_AUTH_CONCURRENCY=4
# YANXING_AUTH_QUEUE_LIMIT=32
